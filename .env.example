# Copy this file to .env and fill in real values. Never commit .env.

# Facebook Page Access Token (Page linked to your Instagram professional account)
# Meta App Dashboard > your app > Instagram > API setup, or Graph API Explorer
PAGE_ACCESS_TOKEN=

# Instagram-scoped User ID (IGSID) of YOUR business/creator account
# Graph API Explorer: GET /me?fields=id or GET /{page-id}?fields=instagram_business_account
IG_USER_ID=

# Meta App Dashboard > Settings > Basic > App Secret
APP_SECRET=

# Any string you make up yourself. Enter the SAME value in the Meta
# Webhooks product config when you subscribe your endpoint.
VERIFY_TOKEN=my-own-random-verify-string-123

GRAPH_API_VERSION=v21.0
PORT=5000

# --- Admin UI (the rules editor at /admin) ---
# Leave BOTH blank to disable the admin UI entirely. That is the safe
# default: no password means no page, never an unprotected page.
ADMIN_PASSWORD=
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# --- Rules storage ---
# "file"      = rules.json on disk. Good locally. Edits do NOT survive on
#               Cloud Run, because the container filesystem is ephemeral.
# "firestore" = Google Cloud Firestore (free tier). Use this in production
#               so rules saved in the admin UI persist across restarts.
RULES_BACKEND=file
FIRESTORE_COLLECTION=igbot
